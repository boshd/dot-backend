APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://benji:benji_dev@localhost:5432/benji
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
WEB_CHAT_DEV_IDENTITY_ENABLED=true
FIREBASE_PROJECT_ID=
# Optional one-line service-account JSON. Leave blank for keyless public-key verification.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Revocation checks require FIREBASE_SERVICE_ACCOUNT_JSON; keyless verification is fail-closed
# for signature and claims but cannot detect revocation before the ID token expires.
FIREBASE_CHECK_REVOKED=false
AUTH_ELIGIBILITY_IP_LIMIT_PER_MINUTE=10
AUTH_ELIGIBILITY_IP_LIMIT_PER_HOUR=60
AUTH_ELIGIBILITY_IDENTIFIER_LIMIT_PER_HOUR=10
WAITLIST_IP_LIMIT_PER_MINUTE=10
WAITLIST_IP_LIMIT_PER_HOUR=60
WAITLIST_EMAIL_LIMIT_PER_HOUR=6
# Use the public gateway URL when testing group invites or OAuth from another device.
WEB_APP_URL=http://localhost:3000
GENERATED_APP_PUBLIC_URL=http://localhost:3000
BENJI_PUBLIC_API_URL=http://localhost:8000
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_CONNECT_LINK_TTL_MINUTES=15
INTEGRATION_OAUTH_STATE_TTL_MINUTES=10
USER_EVENT_POLL_INTERVAL_SECONDS=1
USER_EVENT_MAX_ATTEMPTS=8
SCHEDULED_TASK_MAX_ATTEMPTS=8
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_PUBSUB_PUSH_VERIFICATION_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA
PLAID_WEBHOOK_URL=https://YOUR_PUBLIC_HOST/api/v1/webhooks/plaid
PLAID_REDIRECT_URI=https://YOUR_PUBLIC_HOST/
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=+16463038325
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_AUTOMATED_REPLIES_ENABLED=true
LINQ_SHARE_CONTACT_CARD_ENABLED=false
AGENT_MODEL_PROVIDER=openai
AGENT_CONTEXT_MESSAGE_LIMIT=40
AGENT_MAX_TOOL_ROUNDS=5
AGENT_INTER_BUBBLE_DELAY_SECONDS=0.65
AGENT_TYPING_SECONDS_PER_CHARACTER=0.022
AGENT_TYPING_MAX_DELAY_SECONDS=3.2
AGENT_GROUP_ACK_SETTLE_SECONDS=1.75
AGENT_FOLLOW_UPS_ENABLED=true
AGENT_FOLLOW_UP_MIN_DELAY_SECONDS=90
AGENT_FOLLOW_UP_MAX_DELAY_SECONDS=86400
AGENT_FOLLOW_UP_MAX_CHAIN_DEPTH=1
AGENT_FOLLOW_UP_MAX_ATTEMPTS=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
APP_BUILDER_PROVIDER=local
APP_BUILDER_MODEL=gpt-5.6-terra
APP_BUILDER_REASONING_EFFORT=medium
APP_BUILDER_POLL_INTERVAL_SECONDS=0.5
APP_BUILDER_TIMEOUT_SECONDS=240
APP_BUILDER_MAX_REPAIR_ATTEMPTS=2
APP_BUILDER_LEASE_SECONDS=300
APP_BUILDER_BROWSER_TIMEOUT_SECONDS=12
# Temporary Railway-only fallback. Leave false wherever Chromium's native sandbox works.
APP_BUILDER_ALLOW_UNSANDBOXED_CHROMIUM_ON_RAILWAY=false
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=openai
WEB_SEARCH_MODEL=gpt-5.6-luna
WEB_SEARCH_REASONING_EFFORT=low
WEB_SEARCH_MAX_SOURCES=5

MEMORY_ENABLED=true
MEMORY_CONTEXT_LIMIT=12
MEMORY_CANDIDATE_LIMIT=100
MEMORY_WORKER_POLL_INTERVAL_SECONDS=1
MEMORY_WORKER_MAX_ATTEMPTS=8
MEMORY_MODEL_PROVIDER=openai
MEMORY_MODEL=gpt-5.6-luna
MEMORY_REASONING_EFFORT=low
MEMORY_EMBEDDING_PROVIDER=openai
